{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "starlit-christmas-album",
  "main": "worker.js",
  "compatibility_date": "2026-11-19",
  "workers_dev": true,
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": ["/", "/health", "/photos", "/photos/*"]
  },
  "vars": {
    "GITHUB_REPOSITORY": "hutaohh1/starlit-christmas",
    "ALBUM_BRANCH": "album",
    "ALLOWED_ORIGINS": "https://hutaohh1.github.io,https://starlit-christmas-album.starlit-christmas.workers.dev,http://localhost:5173,http://localhost:5174"
  },
  "ratelimits": [{"name": "UPLOAD_LIMITER", "namespace_id": "1001", "simple": {"limit": 5, "period": 60}}]
}

